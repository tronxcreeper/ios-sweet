+			if (compatible != NULL) {
+				const char target[] = "qcom,smmu-v2";
+				const char *bytes =
+					(const char *)compatible->getBytesNoCopy();
+				unsigned int length = compatible->getLength();
+				unsigned int offset = 0;
+
+				while (bytes != NULL && offset < length) {
+					unsigned int remaining = length - offset;
+					unsigned int itemLength = 0;
+					while (itemLength < remaining &&
+					       bytes[offset + itemLength] != '\0') {
+						itemLength++;
+					}
+					if (itemLength == sizeof(target) - 1 &&
+					    memcmp(bytes + offset, target,
+					           sizeof(target) - 1) == 0) {
+						nub = createNub(smmu);
+						break;
+					}
+					if (itemLength == remaining) {
+						break;
+					}
+					offset += itemLength + 1;
+				}
+			}
+
+			if (nub != NULL) {
+				nub->attach(this);
+				nub->registerService();
+				nub->release();
