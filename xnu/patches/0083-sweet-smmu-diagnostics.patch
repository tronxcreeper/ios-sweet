diff --git a/iokit/Kernel/arm/SweetSMMU.cpp b/iokit/Kernel/arm/SweetSMMU.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetSMMU.cpp
@@ -0,0 +1,77 @@
+/*
+ * SweetSMMU.cpp
+ *
+ * Read-only diagnostic driver for Qualcomm SM7150 SMMU v2.
+ * This version inspects Device Tree resources only; it does not map or
+ * access SMMU registers.
+ */
+
+#include <IOKit/IOService.h>
+#include <IOKit/IODeviceMemory.h>
+
+#define SWEET_SMMU_BASE       0x05040000ULL
+#define SWEET_SMMU_SIZE       0x00010000ULL
+
+class SweetSMMU : public IOService
+{
+    OSDeclareDefaultStructors(SweetSMMU);
+
+public:
+    bool start(IOService *provider) override;
+    void stop(IOService *provider) override;
+};
+
+OSDefineMetaClassAndStructors(SweetSMMU, IOService);
+
+bool
+SweetSMMU::start(IOService *provider)
+{
+    if (!IOService::start(provider)) {
+        return false;
+    }
+
+    /*
+     * Resolve the provider's Device Tree resources.
+     * This does not map or access the SMMU MMIO registers.
+     */
+    if (provider->getResources() != kIOReturnSuccess) {
+        IOLog("SweetSMMU: failed to obtain device resources\n");
+        return false;
+    }
+
+    if (provider->getDeviceMemoryCount() < 1) {
+        IOLog("SweetSMMU: no MMIO resource\n");
+        return false;
+    }
+
+    /*
+     * Borrowed pointer: retained by the provider.
+     * Do not release it.
+     */
+    IODeviceMemory *memory = provider->getDeviceMemoryWithIndex(0);
+    if (memory == nullptr) {
+        IOLog("SweetSMMU: cannot obtain MMIO resource\n");
+        return false;
+    }
+
+    const IOPhysicalAddress address = memory->getPhysicalAddress();
+    const IOByteCount length = memory->getLength();
+
+    IOLog("SweetSMMU: DT resource base=%llx length=%llx\n",
+        (unsigned long long)address,
+        (unsigned long long)length);
+
+    if (address != SWEET_SMMU_BASE || length < SWEET_SMMU_SIZE) {
+        IOLog("SweetSMMU: unexpected MMIO resource; no register access\n");
+        return false;
+    }
+
+    IOLog("SweetSMMU: expected resource found; register access skipped\n");
+    return true;
+}
+
+void
+SweetSMMU::stop(IOService *provider)
+{
+    IOService::stop(provider);
+}
